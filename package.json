{
  "name": "@ailexsi/visualz",
  "version": "0.4.0-arranger",
  "description": "AILEXSI Visualz Arranger — 1 vis + 1 audio, cinematic engine, vis-only export. Resonance Hero is the gold standard.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "tsc && node tools/fix-esm.mjs",
    "build:app": "vite build --config app/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run"
  },
  "keywords": ["ailexsi", "visualizer", "audio-reactive", "webgl", "local-first", "arranger"],
  "author": "AILEXSI",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.3",
    "vitest": "^2.1.4"
  },
  "engines": { "node": ">=20" }
}

{
  "productName": "AILEXSI Visualz",
  "version": "0.4.0",
  "identifier": "com.ailexsi.visualz",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "AILEXSI Visualz",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
